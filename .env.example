# Root .env.example — copy relevant vars to each service's environment in Railway.
# Railway auto-injects REDIS_URL and DATABASE_URL when plugins are linked.

# Required in ALL agent services + orchestrator
ANTHROPIC_API_KEY=sk-ant-api03-...

# Auto-injected by Railway Redis plugin
REDIS_URL=redis://default:password@host.railway.internal:6379

# Auto-injected by Railway Postgres plugin
DATABASE_URL=postgresql://postgres:password@host.railway.internal:5432/railway

# Set manually in dashboard service only
# Use the Railway-generated public URL of the orchestrator service
ORCHESTRATOR_URL=https://orchestrator-production.up.railway.app

# Auto-assigned by Railway per service
PORT=3000
